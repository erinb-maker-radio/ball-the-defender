/**
 * Module Loader
 */
class ModuleLoader {
    constructor() {
        this.loadedModules = new Set();
        this.loadingPromises = new Map();
    }

    /**
     * Load a single script
     */
    async loadScript(src) {
        if (this.loadedModules.has(src)) {
            return Promise.resolve();
        }

        if (this.loadingPromises.has(src)) {
            return this.loadingPromises.get(src);
        }

        const promise = new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.onload = () => {
                this.loadedModules.add(src);
                resolve();
            };
            script.onerror = () => reject(new Error(`Failed to load ${src}`));
            document.head.appendChild(script);
        });

        this.loadingPromises.set(src, promise);
        return promise;
    }

    /**
     * Load modules in sequence
     */
    async loadModuleGroup(modules) {
        for (const module of modules) {
            try {
                await this.loadScript(module);
                console.log(`✅ Loaded: ${module}`);
            } catch (error) {
                console.error(`❌ Failed to load: ${module}`, error);
            }
        }
    }

    /**
     * Load all game modules
     */
    async loadGameModules() {
        console.log('🚀 Starting Ball Defender Module Loading...');
        
        try {
            // Load core modules first
            console.log('📦 Loading Core Modules...');
            await this.loadModuleGroup(GAME_CONFIG.modules.core);
            
            // Load utilities
            console.log('🔧 Loading Utilities...');
            await this.loadModuleGroup(GAME_CONFIG.modules.utils);
            
            // Load UI components
            console.log('🎨 Loading UI Components...');
            await this.loadModuleGroup(GAME_CONFIG.modules.ui);
            
            // Load audio system
            console.log('🔊 Loading Audio System...');
            await this.loadModuleGroup(GAME_CONFIG.modules.audio);
            
            // Load game modes
            console.log('🎮 Loading Game Modes...');
            await this.loadModuleGroup(GAME_CONFIG.modules.modes);
            
            // Load leaderboard system
            console.log('🏆 Loading Leaderboard System...');
            await this.loadModuleGroup(GAME_CONFIG.modules.leaderboard);
            
            // Load main game engine last
            console.log('⚡ Loading Game Engine...');
            await this.loadModuleGroup(GAME_CONFIG.modules.game);
            
            // Load debug modules if enabled
            if (GAME_CONFIG.debug) {
                console.log('🐛 Loading Debug Modules...');
                await this.loadModuleGroup(GAME_CONFIG.debugModules);
            }
            
            // Load legacy modules (for compatibility)
            console.log('📜 Loading Legacy Modules...');
            await this.loadModuleGroup(GAME_CONFIG.legacyModules);
            
            console.log('✅ All modules loaded successfully!');
            this.initializeGame();
            
        } catch (error) {
            console.error('❌ Module loading failed:', error);
        }
    }

    /**
     * Initialize the game after all modules are loaded
     */
    initializeGame() {
        console.log('🎯 Initializing Ball Defender...');
        
        // Game should be ready now
        if (typeof window.gameCore !== 'undefined') {
            console.log('✅ Game initialized successfully!');
        } else {
            console.warn('⚠️ Game core not found - checking compatibility...');
        }
    }
}

/**
 * Application Startup
 */
document.addEventListener('DOMContentLoaded', () => {
    console.log(`🎮 Ball Defender v${GAME_CONFIG.version} - Organized Architecture`);
    
    const loader = new ModuleLoader();
    loader.loadGameModules();
});

